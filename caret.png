bezier(0.28, 0.53, 0.7, 1) 0.13s 1 normal both running pulse-scale, 0.76s c=
ubic-bezier(0.42, 0, 0.58, 1) 0.4s 1 normal both running pulse-fade-out; di=
splay: block !important; }

@-webkit-keyframes pulse-scale {=20
  0% { transform: scale(1); }
  100% { transform: scale(var(--pulse-scale)); }
}

@keyframes pulse-scale {=20
  0% { transform: scale(1); }
  100% { transform: scale(var(--pulse-scale)); }
}

@-webkit-keyframes pulse-fade-out {=20
  0% { opacity: 0.2; }
  100% { opacity: 0; }
}

@keyframes pulse-fade-out {=20
  0% { opacity: 0.2; }
  100% { opacity: 0; }
}

:root { --hs-beacon-v-offset: 40px; --hs-beacon-h-offset-right: 40px; --hs-=
beacon-h-offset-left: initial; --hs-beacon-window-v-offset: calc( var(--hs-=
beacon-v-offset) + 0px + 15px ); --hs-beacon-notifications-v-offset: calc( =
var(--hs-beacon-v-offset) + 60px ); --hs-beacon-window-h-offset-right: var(=
--hs-beacon-h-offset-right); --hs-beacon-window-h-offset-left: var(--hs-bea=
con-h-offset-left); --hs-beacon-notifications-h-offset-right: calc( var(--h=
s-beacon-h-offset-right) - 11px ); --hs-beacon-notifications-h-offset-left:=
 calc( var(--hs-beacon-h-offset-left) - 11px ); }

@media (max-height: 740px) {
  :root { --hs-beacon-v-offset: 10px; --hs-beacon-h-offset-right: 20px; }
}

@media (max-width: 450px) {
  :root { --hs-beacon-window-h-offset-right: 0; --hs-beacon-window-h-offset=
-left: 0; }
}

