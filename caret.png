@media (prefers-reduced-motion: reduce) {
  .stack-caret { display: none; }
}

.stack-thinking { letter-spacing: 0.2em; }

.stack-thinking > span { animation: 1.2s ease-in-out 0s infinite normal non=
e running stack-thinking; display: inline-block; }

.stack-thinking > span:nth-child(2) { animation-delay: 0.18s; }

.stack-thinking > span:nth-child(3) { animation-delay: 0.36s; }

@keyframes stack-thinking {=20
  0%, 70%, 100% { opacity: 0.25; }
  35% { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
