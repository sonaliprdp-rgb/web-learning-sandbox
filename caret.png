.icon-wizard-mark { overflow: visible; }

.icon-wizard-mark-sparkle { transform-box: fill-box; transform-origin: cent=
er center; }

.icon-wizard-mark-hat { transform-box: fill-box; transform-origin: center b=
ottom; }

@media (prefers-reduced-motion: no-preference) {
  .icon-wizard-mark:hover .icon-wizard-mark-sparkle { animation: 0.9s ease-=
in-out 0s infinite normal none running icon-wizard-mark-twinkle; }
  .icon-wizard-mark:hover .icon-wizard-mark-sparkle:nth-child(5) { animatio=
n-delay: 0.2s; }
  .icon-wizard-mark:hover .icon-wizard-mark-sparkle:nth-child(6) { animatio=
n-delay: 0.45s; }
  .icon-wizard-mark:hover .icon-wizard-mark-sparkle:nth-child(7) { animatio=
n-delay: 0.65s; }
  .icon-wizard-mark:hover .icon-wizard-mark-hat { animation: 0.9s ease-in-o=
ut 0s infinite normal none running icon-wizard-mark-wobble; }
}

@keyframes icon-wizard-mark-twinkle {=20
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.55; transform: scale(1.45); }
}

@keyframes icon-wizard-mark-wobble {=20
  0%, 100% { transform: rotate(-7deg); }
  50% { transform: rotate(7deg); }
}

.stack-panel-body { display: grid; grid-template-columns: 1fr 14rem; }

#stack-panel:focus:not(:focus-visible), .stack-pill:focus:not(:focus-visibl=
e), .stack-replay:focus:not(:focus-visible) { outline: none; }

#stack-panel:focus-visible, .stack-pill:focus-visible, .stack-replay:focus-=
visible { outline: 2px solid var(--fa-yellow); outline-offset: 2px; }

.stack-caret { animation: 1s steps(1) 0s infinite normal none running stack=
-caret-blink; background: var(--fa-gravy); display: inline-block; height: 1=
.1em; margin-left: 1px; vertical-align: text-bottom; width: 0.55em; }

@keyframes stack-caret-blink {=20
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0; }
