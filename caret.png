 normal both running stack-preview-pop; }

@keyframes stack-preview-pop {=20
  0% { transform: scale(0); }
  100% { transform: scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .stack-preview-pop { animation: auto ease 0s 1 normal none running none; =
}
